PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Supabase API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# SERVICE ROLE KEY — server only, never expose to client or VITE_ vars
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct PostgreSQL connection (Supabase → Project Settings → Database)
# Use the URI from "Connection string" → URI mode (Transaction or Session pooler)
# Example: postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# Optional: email / notification provider
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=
